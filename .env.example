# Copy to .env.local (gitignored) and fill in from the Supabase dashboard:
# Project Settings → API Keys. The publishable key is safe in the browser;
# row-level security is what keeps each diary private.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
